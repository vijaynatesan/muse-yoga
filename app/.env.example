# Copy to .env and fill in. Never commit .env.
PORT=8080
HOST=0.0.0.0
META_API_KEY=
OPENROUTER_API_KEY=
# AI provider: mock (offline, no spend) | meta (Meta API direct) | openrouter (OpenRouter: meta/muse-wonder, meta/muse-voice-transcribe-1.0, meta/muse-image)
AI_PROVIDER=mock
# Optional per-feature override (text = steps/judging/pose validation, image = step images, voice = transcribe), e.g. keep images on Meta:
# AI_IMAGE_PROVIDER=meta
# Optional OpenRouter model overrides: OPENROUTER_TEXT_MODEL / OPENROUTER_VISION_MODEL / OPENROUTER_IMAGE_MODEL / OPENROUTER_VOICE_MODEL
MAILER=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=Muse Yoga <you@gmail.com>
SESSION_SECRET=change-me-local-dev-secret

# DEBUG ONLY: 1 = show on the Results screen the exact photos + reference sent to the model (kept in memory, never stored). Leave 0 normally.
DEBUG_SHOW_PHOTOS=0
